# Copy to .env and fill in. Never commit .env.

# 32 random bytes, base64. Encrypts source tokens in SQLite.
# Back it up separately from the database: without it, stored tokens are unreadable.
# PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# fish:       openssl rand -base64 32
TOKEN_ENC_KEY=

# SQLite file. Defaults to .data/tsuzuku.db
DATABASE_PATH=.data/tsuzuku.db

# Base URL the browser uses. OAuth redirect URLs are built from it:
#   <APP_URL>/api/auth/trakt/callback, /simkl/callback, /mal/callback
# Register exactly these on each source's app page.
APP_URL=http://localhost:3000

# Trakt: https://trakt.tv/oauth/applications (needs GitHub linked).
# New Trakt apps sign in with PKCE and get no client secret, so only the ID is needed.
TRAKT_CLIENT_ID=

# Simkl: https://simkl.com/settings/developer/ (AUTH V2 app, type "Server apps & services").
# The secret is shown once when the app is created.
SIMKL_CLIENT_ID=
SIMKL_CLIENT_SECRET=

# MyAnimeList: https://myanimelist.net/apiconfig (app type "web")
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=

# TMDB: https://www.themoviedb.org/settings/api (not used yet; show metadata later)
TMDB_API_KEY=
