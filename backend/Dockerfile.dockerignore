# The build context is the repository root (see Dockerfile). Only the server, the Flutter app's sources (for its
# web build) and the files that name the commit (server/lib/version.ts) go in; the history and docs stay out.
*
!backend
!app/pubspec.yaml
!app/pubspec.lock
!app/lib
!app/web
!app/assets
!.git/HEAD
!.git/refs
!.git/packed-refs

# Never in the image: secrets, local data, build output and dependencies (rebuilt inside).
backend/.env
backend/.env.*
!backend/.env.example
backend/.data
backend/data
**/*.db
**/*.db-wal
**/*.db-shm
backend/node_modules
backend/.nitro
backend/.output
backend/.cache
backend/.claude
